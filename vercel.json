{
  "version": 2,
  "framework": null,
  "buildCommand": "npm ci --prefix server && node server/build.mjs",
  "installCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/proxy.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?endpoint=:path*"
    }
  ]
}
